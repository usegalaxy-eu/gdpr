---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.scss';

interface Props {
  title: string;
}

// Markdown layouts receive frontmatter both directly and under frontmatter key
const frontmatter = (Astro.props as any).frontmatter ?? {};
const title: string = Astro.props.title ?? frontmatter.title ?? '';
const pageUrl = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <Head title={title} pageUrl={pageUrl} />
  <body>
    <div id="wrap">
      <div id="main">
        <Header title={title} pageUrl={pageUrl} />
        <div class="container" id="maincontainer">
          <h1>{title}</h1>
          <slot />
        </div>
      </div>
    </div>
    <Footer />
  </body>
</html>
